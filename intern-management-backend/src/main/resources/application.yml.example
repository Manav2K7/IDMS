# Template only — copy to application.yml and fill in real values.
# The real application.yml is git-ignored so credentials stay out of git.
spring:
  application:
    name: intern-management-backend

  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:internmgmt}
    username: ${DB_USERNAME:your_db_user}
    password: ${DB_PASSWORD:your_db_password}

  # Schema is managed by Flyway (src/main/resources/db/migration). Hibernate
  # only validates the entities against the migrated schema.
  flyway:
    enabled: true
    baseline-on-migrate: true
    locations: classpath:db/migration

  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        format_sql: true

server:
  port: ${SERVER_PORT:8080}

app:
  cors:
    # Comma-separated frontend origins; never use '*' in production.
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:4200}

  security:
    jwt:
      # Generate with: openssl rand -base64 48
      # Never commit a real key — inject it via the JWT_SECRET env var.
      secret: ${JWT_SECRET:}
      expiration-ms: 86400000
